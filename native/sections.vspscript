// Convert selected fuselage sections through the native OpenVSP API.
int main(){
 ClearVSPModel();
 ReadVSPFile("Source.vsp3");
 array<string> ids={"SS_SELECTED"};
 for(uint k=0;k<ids.length();k++){
 string g=ids[k]; string surf=GetXSecSurf(g,0);
 for(int i=0;i<GetNumXSec(surf);i++){string xs=GetXSec(surf,i); if(GetXSecShape(xs)==XS_POINT) continue;
 if(GetXSecShape(xs)!=XS_EDIT_CURVE){ConvertXSecToEdit(g,i); Update();} xs=GetXSec(surf,i); EditXSecConvertTo(xs,CEDIT); SetParmVal(GetXSecParm(xs,"AbsoluteFlag"),0); Update();}
 }
 if(GetNumTotalErrors()>0){while(GetNumTotalErrors()>0){ErrorObj e=PopLastError(); Print(e.GetErrorString());} Print("SECTION_STUDIO_ERROR");return 1;}
 WriteVSPFile("Source_prepared.vsp3",SET_ALL);
 if(GetNumTotalErrors()>0){Print("SECTION_STUDIO_ERROR");return 1;} Print("SECTION_STUDIO_SAVED: Source_prepared.vsp3");return 0;
}
